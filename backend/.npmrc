# multer-storage-cloudinary@4.0.0 declares a peer dep on cloudinary ^1.21.0 that
# was never updated for Cloudinary's v2 npm release; its actual API usage
# (cloudinary.uploader/.config) is unaffected. Without this, a clean `npm install`
# (e.g. on Render/CI) fails with ERESOLVE. See git log for the investigation.
legacy-peer-deps=true
